node_modules/
dist/
dist-ssr/
*.local

# Android (Capacitor, lot 4) — le projet natif est versionné (manifeste,
# build.gradle, ressources d'icônes), seuls ses artefacts de build ne le sont pas.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/*.apk
android/**/gradle-*.log
ios/

# Signature de production — jamais versionnée, sous aucune forme.
# La clé perdue rend toute mise à jour impossible ; la clé publiée permet à
# n'importe qui de fabriquer une fausse mise à jour du carnet.
android/signature.properties
*.jks
*.keystore

# Éditeurs
.vscode/*
!.vscode/extensions.json
.idea/

# Système
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
